# Required server settings. For isolated Windows setup, run npm run db:local.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=
SESSION_HOURS=8
DATABASE_URL=
# Owner credential used only by migration/seed/test scripts; never the runtime connection.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=10

# Phase 2 private local storage. S3 is reserved for a future adapter.
STORAGE_PROVIDER=local
STORAGE_PATH=./.local-storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Model credentials are server-only. Never prefix them with NEXT_PUBLIC_.
MODEL_API_MODE=mock
MODEL_API_URL=
MODEL_API_TOKEN=
MODEL_INPUT_BASE_URL=
MODEL_API_TIMEOUT_MS=30000

MAX_UPLOAD_MB=25
MAX_DOCUMENT_PAGES=100
MAX_BATCH_FILES=20
CONFIDENCE_HIGH_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70

INTEGRATION_MODE=mock
LOG_LEVEL=info
