# Proposed configuration only; no runtime reads these values yet.
APP_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=
DATABASE_POOL_MAX=10

STORAGE_PROVIDER=s3
STORAGE_PATH=./.local-storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Model credentials are server-only. Never prefix them with NEXT_PUBLIC_.
MODEL_PROVIDER=mock
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_CONTRACT_VERSION=1.0
MODEL_PROFILE=
MODEL_HTTP_TIMEOUT_MS=30000
MODEL_JOB_TIMEOUT_MS=900000
MODEL_POLL_INTERVAL_MS=5000
MODEL_MAX_ATTEMPTS=3

MAX_UPLOAD_MB=25
MAX_DOCUMENT_PAGES=100
MAX_BATCH_FILES=20
CONFIDENCE_HIGH_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70

INTEGRATION_MODE=mock
LOG_LEVEL=info
